# Copy this file to .env (same folder as docker-compose.yml). docker-compose
# reads these values from here automatically.

# Groq Cloud — runs the LLM. Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Optional. Defaults live in backend/app/config.py; uncomment to override.
# LLM_MODEL=qwen/qwen3.6-27b
# "default" = the model reasons before answering (~5s, better citations).
# "none" = skip reasoning (~1.5s, but tends to cite "Source 3" over book titles).
# LLM_REASONING_EFFORT=default

# Qdrant Cloud (privacy isn't a hard requirement, so vectors live in a managed
# cluster instead of a local container — one less thing to run yourself).
# 1. Sign up free at https://cloud.qdrant.io
# 2. Create a cluster, copy its URL (looks like https://xxxxx.cloud.qdrant.io)
# 3. Create an API key and paste both below
QDRANT_HOST=https://your-cluster-id.cloud.qdrant.io
QDRANT_API_KEY=your-api-key-here

SQLITE_PATH=./backend/data/pmrag.db
UPLOAD_DIR=./backend/data/uploads
MAX_STORAGE_MB=1024
